{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glow development contract gapp-dev-v1",
  "description": "Synthetic presentation contract only. Not a production recommendation, eligibility, ranking or HDE contract. Numeric and collection bounds are development parser limits, not launch policy.",
  "$ref": "#/$defs/DevelopmentRecommendations",
  "$defs": {
    "DevelopmentRecommendations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "contract_version", "items"],
      "properties": {
        "mode": {"const": "fixture"},
        "contract_version": {"const": "gapp-dev-v1"},
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/DevelopmentProfile"},
          "description": "Stable fixture order has no ranking meaning. Empty lists are valid. Consumers additionally reject duplicate profile_id values; JSON Schema does not express that key-level uniqueness invariant."
        }
      }
    },
    "DevelopmentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "display_name", "age", "summary", "compatibility"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
        "age": {"type": "integer", "minimum": 18, "maximum": 120},
        "summary": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
        "compatibility": {"$ref": "#/$defs/FixtureCompatibility"}
      }
    },
    "FixtureCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source"],
      "properties": {
        "status": {"const": "pending"},
        "source": {"const": "fixture"}
      }
    },
    "Liveness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"const": "alive"}}
    },
    "Readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mode", "reason"],
      "properties": {
        "status": {"const": "not_ready"},
        "mode": {"const": "fixture"},
        "reason": {"const": "live_integrations_not_configured"}
      }
    }
  }
}
