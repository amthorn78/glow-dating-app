{
  "name": "@glow/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "expo": "58.0.22",
    "expo-constants": "58.0.14",
    "expo-font": "58.0.11",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.29",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.6",
    "@types/react": "19.2.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "scripts": {
    "start": "node scripts/development.mjs start",
    "android": "node scripts/development.mjs start --android",
    "ios": "node scripts/development.mjs start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts scripts/*.test.mjs",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:expo": "node scripts/development.mjs install --check",
    "export:development": "node scripts/development.mjs export --dev --platform all --output-dir .work/native-export",
    "test:rendered": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  }
}
