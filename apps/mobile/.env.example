# All EXPO_PUBLIC variables are readable by app users. Never put secrets here.
GLOW_APP_ENV=development
EXPO_PUBLIC_GLOW_MODE=fixture
# Optional. Leave unset to use the bundled, clearly labeled synthetic preview.
# For the API smoke flow, set the origin of your isolated local API.
# iOS simulator: http://127.0.0.1:8000
# Android emulator: http://10.0.2.2:8000
# A physical device needs an explicitly configured reachable development origin.
# EXPO_PUBLIC_GLOW_API_BASE_URL=http://127.0.0.1:8000
